;;; everforest-zed-theme.el --- Zed Everforest Dark Soft colors -*- lexical-binding: t; -*-

;; Copyright (c) 2025 Albert Skonieczny
;; SPDX-License-Identifier: MIT
;; Package-Requires: ((emacs "31.1"))
;; Source: https://github.com/albertsko/zed-everforest
;; Palette: Zed extension everforest 0.2.0, Everforest Dark Soft (material).
;; See LICENSE.everforest-zed for the upstream MIT license.

;;; Commentary:
;; 颜色来自本机 Zed 的 everforest-material.json，而非旧 Emacs 配置。
;; Emacs 的 face 对应 Zed 的语义颜色；两种编辑器的语法分类并不完全相同。
;; everforest-zed-comment-alert 对应 Zed 设置中 TODO/error 注释的 #ff5555。
;; 主题只定义外观，注释匹配规则由语言配置负责。

;;; Code:

(deftheme everforest-zed
  "Everforest Dark Soft (material), adapted from Zed extension 0.2.0."
  :background-mode 'dark
  :kind 'color-scheme)

(defface everforest-zed-comment-alert
  '((t (:inherit font-lock-warning-face)))
  "TODO 或 error 注释的强调颜色，对应用户的 Zed 覆盖。"
  :group 'font-lock-faces)

(let ((bg "#333c43")
      (fg "#d3c6aa")
      (line "#3a464c")
      (border "#293136")
      (muted "#859289")
      (doc "#9da9a0")
      (gutter "#7a8478")
      (highlight "#4d5960")
      (selection "#5c3f4f")
      (green-bg "#48584e")
      (blue-bg "#3f5865")
      (red-bg "#59464c")
      (red "#e67e80")
      (orange "#e69875")
      (yellow "#dbbc7f")
      (green "#a7c080")
      (aqua "#83c092")
      (blue "#7fbbb3")
      (purple "#d699b6"))
  (custom-theme-set-faces
   'everforest-zed
   ;; 基础界面。选区和光标直接采用 Zed 的 players[0] 颜色。
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,red))))
   `(fringe ((t (:background ,bg :foreground ,muted))))
   `(vertical-border ((t (:foreground ,border))))
   `(window-divider ((t (:foreground ,border))))
   `(window-divider-first-pixel ((t (:foreground ,border))))
   `(window-divider-last-pixel ((t (:foreground ,border))))
   `(region ((t (:background ,selection :extend t))))
   `(secondary-selection ((t (:background ,blue-bg :extend t))))
   `(highlight ((t (:background ,green-bg))))
   `(hl-line ((t (:background ,line :extend t))))
   `(line-number ((t (:background ,bg :foreground ,gutter))))
   `(line-number-current-line ((t (:background ,line :foreground ,fg))))
   `(shadow ((t (:foreground ,muted))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,purple :underline t))))
   `(button ((t (:inherit link))))
   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   `(trailing-whitespace ((t (:background ,red-bg))))
   `(escape-glyph ((t (:foreground ,green))))
   `(homoglyph ((t (:foreground ,yellow))))
   `(nobreak-space ((t (:foreground ,yellow :underline t))))
   `(tooltip ((t (:background ,line :foreground ,fg))))
   `(mode-line ((t (:background ,green-bg :foreground ,fg :box nil))))
   `(mode-line-inactive ((t (:background ,bg :foreground ,muted :box nil))))
   `(mode-line-buffer-id ((t (:foreground ,green :weight bold))))
   `(mode-line-emphasis ((t (:foreground ,yellow :weight bold))))
   `(header-line ((t (:background ,line :foreground ,fg :box nil))))
   `(tab-bar ((t (:background ,bg :foreground ,fg))))
   `(tab-bar-tab ((t (:background ,green-bg :foreground ,fg :box nil))))
   `(tab-bar-tab-inactive ((t (:background ,bg :foreground ,muted :box nil))))
   `(isearch ((t (:background ,highlight :foreground ,fg :weight bold))))
   `(isearch-fail ((t (:background ,red-bg :foreground ,red))))
   `(lazy-highlight ((t (:background ,line :foreground ,yellow))))
   `(match ((t (:background ,highlight :foreground ,fg))))
   `(show-paren-match ((t (:background ,highlight :foreground ,fg :weight bold))))
   `(show-paren-mismatch ((t (:background ,red-bg :foreground ,red :weight bold))))
   `(minibuffer-prompt ((t (:foreground ,green :weight bold))))
   `(completions-common-part ((t (:foreground ,green :weight bold))))
   `(completions-first-difference ((t (:foreground ,orange))))
   `(completions-annotations ((t (:foreground ,muted))))
   `(completions-highlight ((t (:background ,green-bg :foreground ,fg))))

   ;; Emacs 31 的细粒度 font-lock face 能区分数字、属性和标点。
   `(font-lock-comment-face ((t (:foreground ,muted :slant normal))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,muted :slant normal))))
   `(font-lock-doc-face ((t (:foreground ,doc :slant normal))))
   `(font-lock-doc-markup-face ((t (:foreground ,blue))))
   `(font-lock-string-face ((t (:foreground ,aqua))))
   `(font-lock-keyword-face ((t (:foreground ,red))))
   `(font-lock-builtin-face ((t (:foreground ,aqua))))
   `(font-lock-function-name-face ((t (:foreground ,green))))
   `(font-lock-function-call-face ((t (:foreground ,green))))
   `(font-lock-variable-name-face ((t (:foreground ,fg))))
   `(font-lock-variable-use-face ((t (:foreground ,fg))))
   `(font-lock-type-face ((t (:foreground ,yellow))))
   `(font-lock-constant-face ((t (:foreground ,fg))))
   `(font-lock-number-face ((t (:foreground ,purple))))
   `(font-lock-operator-face ((t (:foreground ,orange))))
   `(font-lock-property-name-face ((t (:foreground ,blue))))
   `(font-lock-property-use-face ((t (:foreground ,blue))))
   `(font-lock-preprocessor-face ((t (:foreground ,purple))))
   `(font-lock-negation-char-face ((t (:foreground ,orange))))
   `(font-lock-regexp-face ((t (:foreground ,green))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,green))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,yellow))))
   `(font-lock-escape-face ((t (:foreground ,green))))
   `(font-lock-punctuation-face ((t (:foreground ,muted))))
   `(font-lock-bracket-face ((t (:foreground ,fg))))
   `(font-lock-delimiter-face ((t (:foreground ,muted))))
   `(font-lock-misc-punctuation-face ((t (:foreground ,blue))))
   `(font-lock-warning-face ((t (:foreground ,red :weight bold))))
   '(everforest-zed-comment-alert ((t (:foreground "#ff5555" :weight bold))))

   ;; Org 保留原生排版，只为标题、链接、表格和代码指定颜色。
   `(org-document-title ((t (:foreground ,orange :weight bold))))
   `(org-document-info ((t (:foreground ,blue))))
   `(org-document-info-keyword ((t (:foreground ,muted))))
   `(org-level-1 ((t (:foreground ,orange :weight bold))))
   `(org-level-2 ((t (:foreground ,yellow :weight bold))))
   `(org-level-3 ((t (:foreground ,green :weight bold))))
   `(org-level-4 ((t (:foreground ,aqua :weight bold))))
   `(org-level-5 ((t (:foreground ,blue :weight bold))))
   `(org-level-6 ((t (:foreground ,purple :weight bold))))
   `(org-level-7 ((t (:foreground ,orange :weight bold))))
   `(org-level-8 ((t (:foreground ,yellow :weight bold))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-headline-done ((t (:foreground ,muted))))
   `(org-priority ((t (:foreground ,red))))
   `(org-tag ((t (:foreground ,purple))))
   `(org-date ((t (:foreground ,blue :underline t))))
   `(org-link ((t (:inherit link))))
   `(org-table ((t (:foreground ,blue))))
   `(org-code ((t (:foreground ,green))))
   `(org-verbatim ((t (:foreground ,aqua))))
   `(org-block ((t (:background ,line :foreground ,fg :extend t))))
   `(org-block-begin-line ((t (:background ,line :foreground ,muted :extend t))))
   `(org-block-end-line ((t (:inherit org-block-begin-line))))
   `(org-meta-line ((t (:foreground ,muted))))
   `(org-special-keyword ((t (:foreground ,red))))
   `(org-drawer ((t (:foreground ,muted))))
   `(org-property-value ((t (:foreground ,aqua))))
   `(org-ellipsis ((t (:foreground ,muted :underline nil))))
   `(org-hide ((t (:foreground ,bg))))

   ;; 文件管理和内置版本控制。
   `(dired-directory ((t (:foreground ,green :weight bold))))
   `(dired-symlink ((t (:foreground ,blue))))
   `(dired-broken-symlink ((t (:foreground ,red :weight bold))))
   `(dired-mark ((t (:foreground ,yellow :weight bold))))
   `(dired-marked ((t (:foreground ,yellow :weight bold))))
   `(dired-flagged ((t (:foreground ,red :weight bold))))
   `(dired-warning ((t (:foreground ,red))))
   `(dired-ignored ((t (:foreground ,muted))))
   `(diff-added ((t (:background ,green-bg :foreground ,green :extend t))))
   `(diff-removed ((t (:background ,red-bg :foreground ,red :extend t))))
   `(diff-changed ((t (:background ,blue-bg :foreground ,blue :extend t))))
   `(diff-header ((t (:background ,line :foreground ,blue))))
   `(diff-file-header ((t (:background ,line :foreground ,green :weight bold))))
   `(diff-hunk-header ((t (:background ,line :foreground ,purple))))

   ;; 第三方 face 可以在包加载之前声明，包安装与否均可加载主题。
   `(vertico-current ((t (:background ,green-bg :extend t))))
   `(vertico-group-title ((t (:foreground ,yellow :weight bold))))
   `(vertico-group-separator ((t (:foreground ,muted))))
   `(vertico-multiline ((t (:foreground ,muted))))
   `(consult-preview-match ((t (:background ,highlight))))
   `(consult-highlight-match ((t (:background ,highlight :foreground ,fg))))
   `(consult-file ((t (:foreground ,fg))))
   `(consult-line-number ((t (:foreground ,muted))))
   `(consult-line-number-prefix ((t (:foreground ,muted))))
   `(consult-key ((t (:foreground ,yellow))))
   `(consult-async-running ((t (:foreground ,yellow))))
   `(consult-async-finished ((t (:foreground ,green))))
   `(consult-async-failed ((t (:foreground ,red))))
   `(marginalia-documentation ((t (:foreground ,doc))))
   `(marginalia-file-priv-dir ((t (:foreground ,green))))
   `(marginalia-file-priv-link ((t (:foreground ,blue))))
   `(marginalia-file-priv-exec ((t (:foreground ,red))))
   `(marginalia-size ((t (:foreground ,purple))))
   `(marginalia-date ((t (:foreground ,blue))))
   `(marginalia-key ((t (:foreground ,yellow))))
   `(marginalia-type ((t (:foreground ,yellow))))
   `(corfu-default ((t (:background ,line :foreground ,fg))))
   `(corfu-current ((t (:background ,green-bg :foreground ,fg))))
   `(corfu-border ((t (:background ,border))))
   `(corfu-bar ((t (:background ,muted))))
   `(corfu-annotations ((t (:foreground ,doc))))
   `(which-key-key-face ((t (:foreground ,green :weight bold))))
   `(which-key-special-key-face ((t (:foreground ,orange :weight bold))))
   `(which-key-separator-face ((t (:foreground ,muted))))
   `(which-key-command-description-face ((t (:foreground ,fg))))
   `(which-key-group-description-face ((t (:foreground ,yellow))))
   `(which-key-local-map-description-face ((t (:foreground ,blue))))
   `(which-key-note-face ((t (:foreground ,muted))))
   `(which-key-docstring-face ((t (:foreground ,doc))))
   `(which-key-highlighted-command-face ((t (:foreground ,green :weight bold))))

   ;; 诊断采用 Zed 的 error/warning/info；红色注释覆盖独立于普通错误。
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,green)))))
   `(flymake-error-echo ((t (:foreground ,red))))
   `(flymake-warning-echo ((t (:foreground ,yellow))))
   `(flymake-note-echo ((t (:foreground ,green))))
   `(compilation-error ((t (:foreground ,red))))
   `(compilation-warning ((t (:foreground ,yellow))))
   `(compilation-info ((t (:foreground ,green))))
   `(eglot-highlight-symbol-face ((t (:background ,blue-bg))))
   `(eglot-diagnostic-tag-unnecessary-face ((t (:foreground ,muted))))
   `(eglot-diagnostic-tag-deprecated-face ((t (:strike-through t))))
   `(eglot-inlay-hint-face ((t (:foreground ,muted :height 0.9))))
   `(eglot-code-action-indicator-face ((t (:foreground ,purple))))
   `(eglot-mode-line ((t (:foreground ,green :weight bold))))

   ;; LSP 语义分类：显式设置与原生 font-lock 默认继承不同的几类。
   `(eglot-semantic-namespace ((t (:foreground ,yellow))))
   `(eglot-semantic-type ((t (:foreground ,yellow))))
   `(eglot-semantic-class ((t (:foreground ,yellow))))
   `(eglot-semantic-enum ((t (:foreground ,yellow))))
   `(eglot-semantic-interface ((t (:foreground ,yellow))))
   `(eglot-semantic-struct ((t (:foreground ,yellow))))
   `(eglot-semantic-typeParameter ((t (:foreground ,yellow))))
   `(eglot-semantic-parameter ((t (:foreground ,fg))))
   `(eglot-semantic-variable ((t (:foreground ,fg))))
   `(eglot-semantic-property ((t (:foreground ,blue))))
   `(eglot-semantic-enumMember ((t (:foreground ,fg))))
   `(eglot-semantic-event ((t (:foreground ,fg))))
   `(eglot-semantic-function ((t (:foreground ,green))))
   `(eglot-semantic-method ((t (:foreground ,green))))
   `(eglot-semantic-macro ((t (:foreground ,purple))))
   `(eglot-semantic-keyword ((t (:foreground ,red))))
   `(eglot-semantic-modifier ((t (:foreground ,red))))
   `(eglot-semantic-comment ((t (:foreground ,muted))))
   `(eglot-semantic-string ((t (:foreground ,aqua))))
   `(eglot-semantic-number ((t (:foreground ,purple))))
   `(eglot-semantic-regexp ((t (:foreground ,green))))
   `(eglot-semantic-operator ((t (:foreground ,orange))))
   `(eglot-semantic-decorator ((t (:foreground ,purple))))
   ;; 修饰符不应把类型、参数等统一染成函数绿或关键词红。
   '(eglot-semantic-declaration ((t (:inherit nil))))
   '(eglot-semantic-definition ((t (:inherit nil))))
   '(eglot-semantic-readonly ((t (:inherit nil))))
   '(eglot-semantic-static ((t (:inherit nil))))
   '(eglot-semantic-abstract ((t (:inherit nil))))
   '(eglot-semantic-async ((t (:inherit nil))))
   '(eglot-semantic-modification ((t (:inherit nil))))
   '(eglot-semantic-defaultLibrary ((t (:inherit nil))))
   `(eglot-semantic-documentation ((t (:foreground ,doc))))))

(provide-theme 'everforest-zed)
;;; everforest-zed-theme.el ends here
